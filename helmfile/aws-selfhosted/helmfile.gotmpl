repositories:
  - name: aws-ebs-csi-driver
    url: https://kubernetes-sigs.github.io/aws-ebs-csi-driver/
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx
 # - name: kubernetes-dashboard
 #   url: https://kubernetes.github.io/dashboard/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
 # - name: aws-ccm
 #   url: https://kubernetes.github.io/cloud-provider-aws
  
releases:
 # - name: prometheus-operator-crds
 #    namespace: monitoring
 #   createNamespace: true
 #   chart: prometheus-community/prometheus-operator-crds
 #   version: 15.0.0
 # - name: aws-cloud-controller-manager
 #  namespace: kube-system
 #   createNamespace: true
 #   chart: aws-ccm/aws-cloud-controller-manager
 #   version: 0.0.10
 #   values:
 #     - image:
 #         repository: registry.k8s.io/provider-aws/cloud-controller-manager
 #         tag: v1.31.0
 #     - args:
 #        - --v=2
 #         - --cloud-provider=aws
 #         - --use-service-account-credentials=true
 #    - tolerations: []       
 #     - nodeSelector: {}  


  - name: aws-ebs-csi-driver
    namespace: kube-system 
    createNamespace: false 
    chart: aws-ebs-csi-driver/aws-ebs-csi-driver
    version: 2.49.0
    values:
      - ./config/aws-ebs-csi.yaml

  - name: ingress-nginx
    namespace: ingress-nginx
    createNamespace: true
    chart: ingress-nginx/ingress-nginx
    version: 4.12.7
    values:
      - controller:
          service:
            annotations:
              service.beta.kubernetes.io/aws-load-balancer-type: "nlb"

  - name: flask-app
    namespace: aws-selfhosted 
    createNamespace: true
    chart: ../../charts/flask-app  
    values:
      - ./config/flask-app.yaml
  
 # - name: kubernetes-dashboard
 #   namespace: kubernetes-dashboard
 #   createNamespace: true
 #   chart: kubernetes-dashboard/kubernetes-dashboard
 #   version: 7.13.0
 #   values:
 #     - ./config/kubernetes-dashboard.yaml

  - name: kube-prometheus-stack
    needs:
      - ingress-nginx/ingress-nginx
    namespace: monitoring 
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: 77.14.0
    values:
      - ./config/prometheus-stack.yaml 

 # - name: grafana
 #   namespace: monitoring
 #   chart: grafana/grafana
 #   version: 6.4.0 # check version
 #   values:
 #     - ./config/grafana.yaml 
 #     - ./config/dashboard.yaml 

  - name: loki-stack
    namespace: monitoring
    chart: grafana/loki-stack
    version: 2.10.2
    values:
      - ./config/loki-stack.yaml 