environments:
  aws-selfhosted:
    values:
      - ./values/aws-selfhosted.yaml
  eks-managed:
    values:
      - ./values/eks-managed.yaml

---

repositories:
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
 # - name: kubernetes-dashboard
 #   url: https://kubernetes.github.io/dashboard/
  
releases:
  - name: ingress-nginx
    namespace: ingress-nginx
    createNamespace: true
    chart: ingress-nginx/ingress-nginx
    version: 4.12.7
    values:
      - controller:
          service:
            annotations:
              service.beta.kubernetes.io/aws-load-balancer-type: "nlb"

  - name: flask-app
    namespace: {{ .Environment.Values.appNamespace }} 
    createNamespace: true
    chart: ../../charts/flask-app  
    values:
      - ./config/flask-app.yaml
      - ingress:
          enabled: true
          className: "nginx"
          annotations:
            nginx.ingress.kubernetes.io/rewrite-target: /
          hosts:
            - host: "flask-app.{{ .Environment.Values.domainSuffix }}"
              paths:
              - path: /
                pathType: Prefix

  - name: kube-prometheus-stack
    needs:
      - ingress-nginx/ingress-nginx
    namespace: monitoring 
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: 77.14.0
    values:
      - ./config/prometheus-stack.yaml 
      - grafana:
          dashboards:
            default:
              flask-app-overview:
                json: {{ readFile "dashboards/flask-app-dashboard.json" | quote }}
          ingress:
            enabled: true
            ingressClassName: nginx
            hosts:
              - "grafana.{{ .Environment.Values.domainSuffix }}"
            path: /
            pathType: Prefix

          adminPassword: {{ env "GRAFANA_ADMIN_PASSWORD" | default "prom-operator2" | quote }}

  - name: loki-stack
    namespace: monitoring
    chart: grafana/loki-stack
    version: 2.10.2
    values:
      - ./config/loki-stack.yaml 
      
