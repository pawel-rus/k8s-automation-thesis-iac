environments:
  aks-managed:
    values:
      - ./values/aks-managed.yaml

---

repositories:
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx
  
releases:
  - name: ingress-nginx
    namespace: ingress-nginx
    createNamespace: true
    chart: ingress-nginx/ingress-nginx
    version: 4.12.7

  - name: flask-app
    namespace: {{ .Environment.Values.appNamespace }} 
    createNamespace: true
    chart: ../../charts/flask-app  
    values:
      - ./config/flask-app.yaml
      - ingress:
          enabled: true
          className: "nginx"
          annotations:
            nginx.ingress.kubernetes.io/rewrite-target: /
          hosts:
            - host: "flask-app.{{ .Environment.Values.domainSuffix }}"
              paths:
              - path: /
                pathType: Prefix
